# Application
DEBUG=False
SECRET_KEY=change-me

# Public URLs
BACKEND_PUBLIC_URL=https://api.example.com
FRONTEND_PUBLIC_URL=https://example.com

# Django host and browser security settings
DJANGO_ALLOWED_HOSTS=example.com,api.example.com,127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Frontend build-time variables
VUE_APP_API_BASE_URL=https://api.example.com/api
VUE_APP_SITE_URL=https://example.com

# VPS metadata
VPS_PUBLIC_IP=203.0.113.10
APP_DOMAIN=example.com
API_DOMAIN=api.example.com

# Nginx template variables
FRONTEND_DOMAIN=example.com
BACKEND_UPSTREAM=127.0.0.1:8000
FRONTEND_UPSTREAM=127.0.0.1:3000
CERTBOT_WEBROOT=/var/www/certbot
SSL_FRONTEND_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_FRONTEND_KEY=/etc/letsencrypt/live/example.com/privkey.pem
SSL_API_CERT=/etc/letsencrypt/live/api.example.com/fullchain.pem
SSL_API_KEY=/etc/letsencrypt/live/api.example.com/privkey.pem
